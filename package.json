{
  "name": "@mutexa/liquidation-map",
  "version": "0.1.1",
  "description": "Public liquidation levels of Hyperliquid's largest accounts: a streaming leaderboard ranker, a budgeted position sampler and a bucketed heatmap whose totals always reconcile, as a library, a Hono route and a CLI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutexa-labs/liquidation-map.git"
  },
  "homepage": "https://github.com/mutexa-labs/liquidation-map#readme",
  "bugs": {
    "url": "https://github.com/mutexa-labs/liquidation-map/issues"
  },
  "keywords": [
    "hyperliquid",
    "liquidation",
    "heatmap",
    "leaderboard",
    "streaming",
    "cloudflare-workers",
    "cli",
    "mutexa"
  ],
  "bin": {
    "liquidation-map": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"{src,test,scripts,examples}/**/*.ts\"",
    "format": "prettier --write \"{src,test,scripts,examples}/**/*.ts\"",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "record": "tsx scripts/record.ts"
  },
  "dependencies": {
    "@mutexa/venue-adapters": "github:mutexa-labs/venue-adapters#v0.1.1"
  },
  "peerDependencies": {
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "hono": "^4.11.1",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
